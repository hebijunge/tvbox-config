   "note": "扫码拿二维码 → 轮询确认换 cookie",
   "reachable": true,
   "http_status": 200,
   "ms": 2008
  },
  {
   "disk": "PikPak",
   "ck_field": "pikpak_username/password",
   "method": "账密",
   "api": "https://user.mypikpak.com/v1/auth/token",
