   "reachable": true,
   "http_status": 200,
   "ms": 3760
  },
  {
   "disk": "天翼云盘",
   "ck_field": "thunder_username/password + captchatoken",
   "method": "账密+验证码",
   "api": "https://m.cloud.189.cn/login.html",
   "note": "账密写入 token.json，登录需验证码",
   "reachable": true,
   "http_status": 404
  },
  {
   "disk": "115网盘",
   "ck_field": "cookie(UID/CID/SEID)",
