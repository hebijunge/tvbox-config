   "reachable": true,
   "http_status": 404
  },
  {
   "disk": "夸克网盘",
   "ck_field": "quark_cookie",
   "method": "网页登录",
   "api": "https://pan.quark.cn",
   "note": "浏览器登录后 F12 复制 Cookie 全量",
   "reachable": true,
   "http_status": 200,
   "ms": 3396
  },
  {
   "disk": "UC网盘",
   "ck_field": "uc_cookie",
   "method": "网页登录",
