  <script>
    // 移动端菜单切换
    function toggleMobileMenu() {
      const mobileMenu = document.getElementById('mobileMenu');
      if (mobileMenu.classList.contains('hidden')) {
        mobileMenu.classList.remove('hidden');
      } else {
        mobileMenu.classList.add('hidden');
      }
    }

    function githubProxy() {
      return {
        inputUrl: '',
        loading: false,
        activeTab: 'clone',
        owner: '',
        repository: '',
        rawBranch: 'main',
        rawPath: 'README.md',
        result: {
          show: false,
          success: false,
          proxyUrl: '',
          error: ''
        },

        // 初始化方法
        init() {
          console.log('GitHub Proxy initialized');
          // 确保初始状态完全重置
          this.loading = false;
          this.activeTab = 'clone';
          this.owner = '';
          this.repository = '';
          this.rawBranch = 'main';
          this.rawPath = 'README.md';
          this.result = {
            show: false,
            success: false,
            proxyUrl: '',
            error: ''
          };
        },

        getLangTexts() {
          const texts = {
            zh: {
              gitCloneLabel: '永久 Git Clone 命令',
              invalidRepository: '请输入有效的 GitHub 公开仓库地址，例如 https://github.com/user/repo',
              tabClone: 'Git Clone',
              tabArchive: 'Archive 源码包',
              tabPip: 'pip 安装',
              tabGo: 'Go 模块代理',
              tabRaw: 'Raw 文件',
              hintArchive: '提示：将 main 替换为仓库默认分支。',
              hintRaw: '提示：将 main 与文件路径替换为实际分支与文件路径。'
            },
            en: {
              gitCloneLabel: 'Permanent Git Clone Command',
              invalidRepository: 'Enter a valid public GitHub repository URL, for example https://github.com/user/repo',
              tabClone: 'Git Clone',
              tabArchive: 'Source Archive',
              tabPip: 'pip Install',
              tabGo: 'Go Module Proxy',
              tabRaw: 'Raw File',
              hintArchive: 'Tip: replace main with the repository\'s default branch.',
              hintRaw: 'Tip: replace main and the file path with the actual branch and file path.'
            }
          };
          const lang = window.location.pathname === '/en' ? 'en' : 'zh';
          return texts[lang];
        },

        getTabList() {
          const t = this.getLangTexts();
          return [
            { id: 'clone', label: t.tabClone },
            { id: 'archive', label: t.tabArchive },
            { id: 'pip', label: t.tabPip },
            { id: 'go', label: t.tabGo },
            { id: 'raw', label: t.tabRaw }
          ];
        },

        getOutputLabel() {
          return this.getLangTexts().gitCloneLabel;
        },

        getProxyRepoUrl() {
          return window.location.origin + '/https://github.com/' + this.owner + '/' + this.repository;
        },

        getOutputCommand() {
          return 'git clone ' + this.getProxyRepoUrl() + '.git';
        },

        getActiveCommand() {
          if (!this.result.success) {
            return '';
          }
          const origin = window.location.origin;
          const o = this.owner;
          const r = this.repository;
          const branch = (this.rawBranch || 'main').trim() || 'main';
          const path = (this.rawPath || '').trim() || 'README.md';

          switch (this.activeTab) {
            case 'archive':
              return 'wget ' + origin + '/https://github.com/' + o + '/' + r + '/archive/refs/heads/' + encodeURIComponent(branch) + '.zip';
            case 'pip':
              return 'pip install git+' + origin + '/https://github.com/' + o + '/' + r + '.git';
            case 'go':
              return 'git config --global url."' + origin + '/https://github.com/".insteadOf "https://github.com/"';
            case 'raw':
              return 'curl -L ' + origin + '/https://raw.githubusercontent.com/' + o + '/' + r + '/' + encodeURIComponent(branch) + '/' + path.split('/').map(encodeURIComponent).join('/');
            case 'clone':
            default:
              return this.getOutputCommand();
          }
        },

        getActiveHint() {
          const t = this.getLangTexts();
          if (this.activeTab === 'archive') {
            return t.hintArchive;
          }
          if (this.activeTab === 'raw') {
            return t.hintRaw;
          }
          return '';
        },

        async generateLink() {
          this.loading = true;

          try {
            const url = new URL(this.inputUrl.trim());
            const pathParts = url.pathname.replace(/\/$/, '').split('/').filter(Boolean);

            if (
              url.protocol !== 'https:' ||
              url.hostname !== 'github.com' ||
              url.username ||
              url.password ||
              url.search ||
              url.hash ||
              pathParts.length !== 2
            ) {
              throw new Error('invalid repository');
            }

            const owner = pathParts[0];
            const repository = pathParts[1].replace(/\.git$/, '');
            if (
              !/^[A-Za-z0-9][A-Za-z0-9-]{0,38}$/.test(owner) ||
              !/^[A-Za-z0-9._-]{1,100}$/.test(repository) ||
              repository === '.' ||
              repository === '..'
            ) {
              throw new Error('invalid repository');
            }

            this.owner = owner;
            this.repository = repository;
            const proxyUrl = window.location.origin + '/https://github.com/' + owner + '/' + repository + '.git';
            this.showSuccess(proxyUrl);
          } catch {
            this.showError(this.getLangTexts().invalidRepository);
          } finally {
            this.loading = false;
          }
        },

        showSuccess(proxyUrl) {
          this.activeTab = 'clone';
          this.result = {
            show: true,
            success: true,
            proxyUrl: proxyUrl,
            error: ''
          };
        },

        showError(message) {
          this.result = {
            show: true,
            success: false,
            proxyUrl: '',
            error: message
          };
        },

        async copyToClipboard(text, event) {
          try {
            await navigator.clipboard.writeText(text);

            // 获取按钮元素
            const button = event.target.closest('button');
            if (button) {
              // 保存原始内容
              const originalHTML = button.innerHTML;

              // 更新按钮状态为成功
              button.innerHTML = '<span class="mr-2">✅</span>复制成功';
              button.classList.remove('bg-gray-600', 'hover:bg-gray-700');
              button.classList.add('bg-green-600', 'hover:bg-green-700');

              // 2秒后恢复原状
              setTimeout(() => {
                button.innerHTML = originalHTML;
                button.classList.remove('bg-green-600', 'hover:bg-green-700');
                button.classList.add('bg-gray-600', 'hover:bg-gray-700');
              }, 2000);
            }
          } catch (error) {
            console.error('复制失败:', error);

            // 获取按钮元素
            const button = event.target.closest('button');
            if (button) {
              // 保存原始内容
              const originalHTML = button.innerHTML;

              // 更新按钮状态为失败
              button.innerHTML = '<span class="mr-2">❌</span>复制失败';
              button.classList.remove('bg-gray-600', 'hover:bg-gray-700');
              button.classList.add('bg-red-600', 'hover:bg-red-700');

              // 2秒后恢复原状
              setTimeout(() => {
                button.innerHTML = originalHTML;
                button.classList.remove('bg-red-600', 'hover:bg-red-700');
                button.classList.add('bg-gray-600', 'hover:bg-gray-700');
              }, 2000);
            }
          }
        }
      };
    }
  </script>

</body>
</html>
  