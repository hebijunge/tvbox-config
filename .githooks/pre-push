#!/bin/sh
# P0-2 本地预检查（push 前自动运行）
# 用法：一次性启用  git config core.hooksPath .githooks
# 紧急逃逸：        git push --no-verify
# 三道关卡：
#   1) py_compile 所有 scripts/*.py —— 语法错误直接阻断（不劳 CI 跑 90 分钟才发现）
#   2) windows_path_check.py       —— Windows 非法路径阻断（CI windows-path-check job 同款）
#   3) 快速冒烟 --site-limit 5      —— 软告警，不阻断（本地网络/依赖缺失时 CI 兜底）
set -e

cd "$(git rev-parse --show-toplevel)" || exit 1

echo "[pre-push] 1/3 编译检查 scripts/*.py ..."
python -m py_compile scripts/*.py || {
  echo "[pre-push] FAIL: 存在 Python 语法错误，已阻断 push"
  exit 1
}

echo "[pre-push] 2/3 Windows 路径兼容性检查 ..."
python scripts/windows_path_check.py || {
  echo "[pre-push] FAIL: Windows 路径不兼容，已阻断 push"
  exit 1
}

echo "[pre-push] 3/3 快速冒烟（--site-limit 5，软告警不阻断）..."
if command -v python >/dev/null 2>&1; then
  python scripts/fetch_merge.py --site-limit 5 || \
    echo "[pre-push] WARN: 快速冒烟未通过（不阻断 push，远端 CI 会兜底；如属网络抖动可忽略）"
fi

echo "[pre-push] OK：本地预检查通过"
